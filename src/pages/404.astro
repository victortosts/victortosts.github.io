---
import Base from '../layouts/Base.astro'
import { profile, features } from '../data/site'
---

<Base title={`404 — ${profile.name}`} description="Page not found.">
  <div class="nf" data-seq data-seq-now>
    <div class="prompt">
      <span class="ps1">{profile.handle}@{profile.host}:~$</span>
      <span class="type" data-type>
        <span class="type-ghost" id="attempted">cd</span>
        <span class="type-live" aria-hidden="true" />
      </span>
      <span class="cursor" aria-hidden="true" />
    </div>
    <p class="msg" data-reveal>bash: <span id="path">that path</span>: No such file or directory</p>
    <p class="hint dim" data-reveal>exit status 404</p>
    <p class="links" data-reveal>
      <a href="/">[~/]</a>
      {features.blog && <a href="/blog">[~/blog]</a>}
    </p>
  </div>
</Base>

<style>
  .nf {
    padding-block: 3rem;
  }

  .msg {
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }

  .hint {
    font-size: 0.78rem;
    margin-top: 0.2rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }

  .links a {
    color: var(--teal);
  }
</style>

<script is:inline>
  ;(() => {
    // Runs before the animation script reads the ghost text.
    const path = window.location.pathname
    const cmd = document.getElementById('attempted')
    const target = document.getElementById('path')
    if (cmd) cmd.textContent = `cd ${path}`
    if (target) target.textContent = path
  })()
</script>
