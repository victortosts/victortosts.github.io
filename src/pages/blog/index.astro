---
import Base from '../../layouts/Base.astro'
import Prompt from '../../components/Prompt.astro'
import PostList from '../../components/PostList.astro'
import { getPosts } from '../../data/posts'
import { profile, links } from '../../data/site'

const posts = await getPosts()
---

<Base title={`blog — ${profile.name}`} description={`Notes on backend engineering by ${profile.name}.`}>
  <div data-seq data-seq-now>
    <Prompt cmd="ls" args="-lt ~/blog" typed />

    <header class="hd" data-reveal>
    <h1 class="sec-heading"><span class="hash">#</span><span class="label">blog</span></h1>
    <p class="dim intro">
      Notes on backends, event-driven systems, and whatever breaks in production this month.
      <a href={links.rss}>rss</a>
      </p>
    </header>

    <PostList posts={posts} headingLevel={2} />
  </div>

  <p class="back"><a href="/" class="dim">← ~/</a></p>
</Base>

<style>
  .hd {
    margin-top: 1.25rem;
  }

  .intro {
    font-size: 0.8rem;
    margin-bottom: 2rem;
  }

  /* Inline in body copy, so color alone must not carry the link. */
  .intro a {
    border-bottom-color: color-mix(in srgb, var(--link) 45%, transparent);
  }

  .back {
    margin-top: 3rem;
    font-size: 0.75rem;
  }
</style>
