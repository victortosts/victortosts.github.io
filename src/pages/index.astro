---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Section from '../components/Section.astro'
import GitLog from '../components/GitLog.astro'
import Stack from '../components/Stack.astro'
import Experience from '../components/Experience.astro'
import Education from '../components/Education.astro'
import OpenSource from '../components/OpenSource.astro'
import { about, profile } from '../data/site'

---

<Base title={profile.name} variant="home">
  <Hero />

  <Section id="about" label="about" cmd="cat" args="about.md">
    <div class="about-text">
      {about.map((p) => <p set:html={p} data-reveal />)}
    </div>
    <GitLog />
  </Section>
  <Section id="education" label="education" cmd="cat" args="~/edu.md">
    <Education />
  </Section>
  <Section id="work" label="work experience" cmd="cat" args="~/work.md">
    <Experience />
  </Section>
  <Section id="stack" label="stack" cmd="ls" args="~/stack">
    <Stack />
  </Section>
  <Section
    id="open-source"
    label="open source"
    cmd="gh"
    args="pr list --author victortosts --state merged"
  >
    <OpenSource />
  </Section>
</Base>

<style>
  .about-text p {
    font-size: 0.85rem;
    color: var(--dim);
  }

  .about-text p + p {
    margin-top: 0.9rem;
  }
</style>
