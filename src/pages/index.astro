---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Section from '../components/Section.astro'
import GitLog from '../components/GitLog.astro'
import Stack from '../components/Stack.astro'
import Experience from '../components/Experience.astro'
import Education from '../components/Education.astro'
import OpenSource from '../components/OpenSource.astro'
import PostList from '../components/PostList.astro'
import { about, profile } from '../data/site'
import { getPosts } from '../data/posts'

const allPosts = await getPosts()
const posts = allPosts.slice(0, 3)
---

<Base title={profile.name} variant="home">
  <Hero postCount={allPosts.length} />

  <Section id="about" label="about" cmd="cat" args="about.md">
    <div class="about-text">
      {about.map((p) => <p set:html={p} data-reveal />)}
    </div>
    <GitLog />
  </Section>

  <Section id="stack" label="stack" cmd="ls" args="~/stack">
    <Stack />
  </Section>

  <Section id="work" label="work experience" cmd="cat" args="~/work.md">
    <Experience />
  </Section>

  <Section
    id="open-source"
    label="open source"
    cmd="gh"
    args="pr list --author victortosts --state merged"
  >
    <OpenSource />
  </Section>

  <Section id="education" label="education" cmd="cat" args="~/edu.md">
    <Education />
  </Section>

  <Section id="writing" label="writing" cmd="ls" args="-lt ~/blog">
    <PostList posts={posts} empty="nothing published yet — first post is on the way." />
    <p class="more" data-reveal><a href="/blog" class="dim">~/blog →</a></p>
  </Section>
</Base>

<style>
  .about-text p {
    font-size: 0.85rem;
    color: var(--dim);
  }

  .about-text p + p {
    margin-top: 0.9rem;
  }

  .more {
    margin-top: 1rem;
    font-size: 0.75rem;
  }
</style>
