---
import { stack } from '../data/site'
---

<dl class="stack">
  {
    stack.map((group) => (
      <div class="row" data-reveal>
        <dt class="label">{group.label}</dt>
        <dd class="items">
          {group.items.map((item, i) => (
            <>
              {i > 0 && <span class="sep faint"> · </span>}
              <span class="item">{item}</span>
            </>
          ))}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .label {
    color: var(--amber);
    font-size: 0.78rem;
  }

  .label::before {
    content: '';
  }

  .items {
    font-size: 0.82rem;
    color: var(--dim);
    margin: 0;
  }

  .item {
    color: var(--text);
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
