---
import { expertise, alsoKnown } from '../data/site'
---

<dl class="stack">
  {
    expertise.map((row) => (
      <div class="row" data-reveal>
        <dt class="hd">
          <span class="area">{row.area}</span>
          <span class="meta">
            <span class={`level level-${row.level}`}>{row.level}</span>
            <span class="faint"> · {row.meta}</span>
          </span>
        </dt>
        <dd class="detail">{row.detail}</dd>
        <dd class="tools">
          <ul>
            {row.tools.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        </dd>
      </div>
    ))
  }

  <div class="row also" data-reveal>
    <dt class="hd">
      <span class="area">also</span>
    </dt>
    <dd class="tools">
      <ul>
        {alsoKnown.map((tool) => (
          <li>{tool}</li>
        ))}
      </ul>
    </dd>
  </div>
</dl>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .hd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .area {
    color: var(--amber);
    font-size: 0.85rem;
  }

  .meta {
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .level-core {
    color: var(--teal);
  }

  .level-strong {
    color: var(--faint);
  }

  .detail {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--dim);
  }

  .tools {
    margin: 0.5rem 0 0;
  }

  .tools ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
  }

  .tools li {
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--dim);
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.05rem 0.45rem;
  }

  .also {
    padding-top: 0.9rem;
    border-top: 1px dashed var(--border);
  }

  .also .tools {
    margin-top: 0.35rem;
  }
</style>
