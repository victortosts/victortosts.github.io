---
import { profile, links } from '../data/site'
import Prompt from './Prompt.astro'
---

<section id="home" class="hero" data-seq data-seq-now>
  <Prompt host="local" cmd="ssh" args={`${profile.handle}@${profile.host}`} typed />
  <p class="connected faint" data-reveal>Connected to {profile.handle}@{profile.host}. Welcome.</p>

  <div class="hero-out" data-reveal>
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">// {profile.role}</p>
    <p class="hero-loc dim">{profile.location}</p>
    <p class="hero-mail dim">
      <span data-mail-user={profile.email.user} data-mail-domain={profile.email.domain}>
        {profile.email.user} [at] {profile.email.domain.replace('.', ' [dot] ')}
      </span>
    </p>

    <p class="hero-links">
      <a href={links.resume} target="_blank" rel="noopener nofollow" download>[resume.pdf]</a>
      <a href={links.blog}>[blog]</a>
      <a href={links.linkedin} target="_blank" rel="noopener">[linkedin]</a>
      <a href={links.github} target="_blank" rel="noopener">[github]</a>
    </p>
  </div>

  <Prompt cmd="whoami" args="--verbose" typed keepCursor />
  <p id="typed-out" class="dim" data-reveal>{profile.tagline}</p>
</section>

<style>
  .hero {
    padding-top: 0.5rem;
  }

  .connected {
    font-size: 0.78rem;
    margin: 0.3rem 0 1.1rem;
  }

  .hero-out {
    border-left: 2px solid var(--border);
    padding-left: 1.1rem;
    margin-bottom: 1.75rem;
  }

  .hero-name {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .hero-role {
    color: var(--amber);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }

  .hero-loc,
  .hero-mail {
    font-size: 0.78rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.78rem;
  }

  .hero-links a {
    color: var(--teal);
  }

  #typed-out {
    padding-left: 1.5rem;
    font-size: 0.8rem;
    margin-top: 0.2rem;
  }

  @media (max-width: 30rem) {
    #typed-out {
      padding-left: 0;
    }
  }
</style>

<script is:inline>
  // Assemble the address only in the browser, so the markup never ships a plain mailto.
  ;(() => {
    const el = document.querySelector('[data-mail-user]')
    if (!(el instanceof HTMLElement)) return
    const { mailUser, mailDomain } = el.dataset
    if (!mailUser || !mailDomain) return
    const addr = `${mailUser}@${mailDomain}`
    const a = document.createElement('a')
    a.href = `mailto:${addr}`
    a.textContent = addr
    el.replaceChildren(a)
  })()
</script>
