---
import { profile, links } from '../data/site'
import Prompt from './Prompt.astro'
import HeroRotator from './HeroRotator.astro'

interface Props {
  postCount?: number
}

const { postCount = 0 } = Astro.props
---

<section id="home" class="hero" data-seq data-seq-now>
  <Prompt host="local" cmd="ssh" args={`${profile.handle}@${profile.host}`} typed />
  <p class="connected faint" data-reveal>Connected to {profile.handle}@{profile.host}. Welcome.</p>

  <div class="hero-out" data-reveal>
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">// {profile.role}</p>
    <p class="hero-loc">{profile.location}</p>
    <p class="hero-links">
      <a href={links.resume} target="_blank" rel="noopener nofollow" download>[resume.pdf]</a>
      <a href={links.blog}>[blog]</a>
      <a href={links.linkedin} target="_blank" rel="noopener">[linkedin]</a>
      <a href={links.github} target="_blank" rel="noopener">[github]</a>
    </p>
  </div>

  <HeroRotator postCount={postCount} />
</section>

<style>
  .hero {
    padding-top: 0.5rem;
  }

  .connected {
    font-size: 0.78rem;
    margin: 0.3rem 0 1.1rem;
  }

  .hero-out {
    border-left: 2px solid var(--border);
    padding-left: 1.1rem;
    margin-bottom: 1.75rem;
  }

  .hero-name {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .hero-role {
    color: var(--amber);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }

  .hero-loc {
    font-size: 0.78rem;
    color: var(--link);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.78rem;
  }

  .hero-links a {
    color: var(--teal);
  }

</style>
