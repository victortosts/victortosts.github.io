---
import { openSource } from '../data/site'
---

<div class="os">
  {
    openSource.map((project) => (
      <article class="project" data-reveal>
        <header class="project-hd">
          <h3 class="repo">
            <a href={project.url} class="plain" target="_blank" rel="noopener">
              {project.repo}
            </a>
          </h3>
          <span class="prs">
            {project.prs.map((pr) => (
              <a href={pr.url} target="_blank" rel="noopener" aria-label={`${project.repo} pull request ${pr.num}`}>
                #{pr.num}
              </a>
            ))}
          </span>
        </header>

        <p class="note faint">{project.note}</p>
        <p class="detail dim">{project.detail}</p>
      </article>
    ))
  }
</div>

<style>
  .os {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .project-hd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .repo {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .prs {
    display: flex;
    gap: 0.6rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .prs a {
    color: var(--teal);
  }

  .note {
    font-size: 0.75rem;
    margin-top: 0.05rem;
  }

  .detail {
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }
</style>
