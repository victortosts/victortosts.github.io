---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import CommandPalette from '../components/CommandPalette.astro'
import { profile } from '../data/site'

interface Props {
  title?: string
  description?: string
  variant?: 'home' | 'page'
  ogType?: 'website' | 'article'
}

const {
  title = profile.name,
  description = profile.description,
  variant = 'page',
  ogType = 'website',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — blog`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set the theme before first paint so the page never flashes the wrong one. -->
    <script is:inline>
      ;(() => {
        const root = document.documentElement

        try {
          const stored = localStorage.getItem('theme')
          const theme =
            stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
          root.setAttribute('data-theme', theme)
        } catch {
          /* private mode / blocked storage: keep the dark default */
        }

        // Opt into the type/reveal animations before first paint. Everything they
        // hide is visible without this class, so reduced motion and a failed script
        // both fall back to the fully rendered page.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('anim')
          setTimeout(() => {
            if (!root.dataset.animReady) root.classList.remove('anim')
          }, 2500)
        }
      })()
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />
  </head>

  <body>
    <div id="progress-bar" aria-hidden="true"></div>
    <a href="#main" class="skip">skip to content</a>

    <Nav variant={variant} />

    <main id="main" class="wrap">
      <slot />
    </main>

    <Footer />
    <CommandPalette variant={variant} />

    <style>
      #progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0;
        background: var(--amber);
        z-index: 60;
        transition: width 0.08s linear;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: 0.5rem 0.75rem;
        background: var(--bg2);
        z-index: 200;
      }

      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
    </style>

    <script>
      // Sequenced terminal animation: types each `[data-type]` command, then fades
      // in the `[data-reveal]` blocks that follow it, staggered. A sequence starts
      // when its `[data-seq]` root scrolls into view, or immediately for `data-seq-now`.
      const root = document.documentElement

      if (root.classList.contains('anim')) {
        root.dataset.animReady = '1'

        const TYPE_MS = 22
        const START_MS = 110
        const STAGGER_MS = 45

        const typeEl = (el: Element) =>
          new Promise<void>((resolve) => {
            const ghost = el.querySelector('.type-ghost')
            const live = el.querySelector('.type-live')
            const prompt = el.closest('.prompt')
            const text = ghost?.textContent ?? ''

            if (!live) {
              resolve()
              return
            }

            prompt?.classList.add('typing')
            let i = 0

            const tick = () => {
              live.textContent = text.slice(0, ++i)
              if (i < text.length) {
                setTimeout(tick, TYPE_MS)
              } else {
                if (!prompt?.hasAttribute('data-keep-cursor')) prompt?.classList.remove('typing')
                resolve()
              }
            }

            setTimeout(tick, START_MS)
          })

        const reveal = (el: Element, delay: number) => {
          ;(el as HTMLElement).style.setProperty('--d', `${delay}ms`)
          el.classList.add('in')
        }

        const run = async (seq: HTMLElement) => {
          if (seq.dataset.ran) return
          seq.dataset.ran = '1'

          let delay = 0
          for (const el of seq.querySelectorAll('[data-type], [data-reveal]')) {
            if (el.hasAttribute('data-type')) {
              await typeEl(el)
              delay = 0
            } else {
              reveal(el, delay)
              delay += STAGGER_MS
            }
          }

          seq.dispatchEvent(new CustomEvent('seq:done'))
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              io.unobserve(entry.target)
              run(entry.target as HTMLElement)
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        )

        for (const seq of document.querySelectorAll<HTMLElement>('[data-seq]')) {
          if (seq.hasAttribute('data-seq-now')) run(seq)
          else io.observe(seq)
        }

        // Anything outside a sequence would otherwise stay hidden.
        for (const el of document.querySelectorAll('[data-reveal]')) {
          if (!el.closest('[data-seq]')) reveal(el, 0)
        }
      }
    </script>

    <script is:inline>
      ;(() => {
        // Theme toggle
        const btn = document.getElementById('theme-btn')
        btn?.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
          document.documentElement.setAttribute('data-theme', next)
          try {
            localStorage.setItem('theme', next)
          } catch {
            /* ignore */
          }
        })

        // Scroll progress
        const bar = document.getElementById('progress-bar')
        if (bar && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const update = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight
            bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0'
          }
          window.addEventListener('scroll', update, { passive: true })
          window.addEventListener('resize', update)
          update()
        }
      })()
    </script>
  </body>
</html>
